# Senha única da área de gestão (/admin). Obrigatória, com no mínimo 12 caracteres.
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão (>= 32 caracteres). Obrigatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# URL base do campaign-codex. Vazio desativa o modo "vinculado ao codex".
CODEX_BASE_URL=https://campaign-codex.1nodado.com.br
# Diretório do banco SQLite e dos uploads.
DATA_DIR=./data
PORT=3000
# Atrás de reverse proxy (Caddy/Cloudflare): confia em X-Forwarded-For/-Proto.
TRUSTED_PROXY=false
# Quantos proxies confiáveis ficam à frente do app (o IP do cliente é lido contando
# do FIM de X-Forwarded-For). Caddy sozinho = 1; Cloudflare + Caddy = 2.
TRUSTED_PROXY_HOPS=1
# Origem pública usada na checagem CSRF (vazio = compara com o cabeçalho Host).
PUBLIC_ORIGIN=
# Força o atributo Secure do cookie (vazio = decide pelo protocolo; em NODE_ENV=production o padrão é true).
COOKIE_SECURE=
# Limites por IP e por minuto (endpoints públicos e /api/admin/*).
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_ADMIN=60
# Cota de disco das imagens enviadas, em MB.
UPLOAD_QUOTA_MB=200
# Portas permitidas na consulta de status do Foundry (lista separada por vírgula).
FOUNDRY_ALLOWED_PORTS=443
