# Senha única da área de gestão (/admin). Obrigatória.
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão (>= 32 caracteres). Obrigatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# URL base do campaign-codex. Vazio desativa o modo "vinculado ao codex".
CODEX_BASE_URL=https://campaign-codex.1nodado.com.br
# Diretório do banco SQLite e dos uploads.
DATA_DIR=./data
PORT=3000
# Atrás de reverse proxy (Caddy/Cloudflare): confia em X-Forwarded-For/-Proto.
TRUSTED_PROXY=false
# Força o atributo Secure do cookie (vazio = decide pelo protocolo).
COOKIE_SECURE=
